{
  "manifest_version": 3,
  "name": "Helo for Claude and ChatGPT",
  "version": "0.1.0",
  "description": "Tells the Helo island on your PC when Claude or ChatGPT is answering and when it has finished.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Helo", "default_popup": "popup.html" }
}
